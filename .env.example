# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored; .env.example is the committed template.

# Required by `pim-whitelist classify`. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI model. If unset, the model resolves to the
# --model flag, then this variable, then config.DEFAULT_OPENAI_MODEL.
# OPENAI_MODEL=gpt-4o-mini
