# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored; .env.example is the committed template.

# Required by `pim-whitelist classify`. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI model. If unset, the model resolves to the
# --model flag, then this variable, then config.DEFAULT_OPENAI_MODEL.
# OPENAI_MODEL=gpt-4o-mini

# Read API (used by examples/query_api.ipynb). BASE_URL defaults to
# http://localhost:8000 if unset; API_KEY is only needed for the deployed
# CloudFront endpoint, which requires an `x-api-key` header.
PIM_API_BASE_URL=https://<your-api-host>
PIM_API_KEY=your-api-key
